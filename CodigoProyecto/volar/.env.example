# Base de datos
DATABASE_URL="postgresql://usuario:password@localhost:5432/volar?schema=public"
DIRECT_URL="postgresql://usuario:password@localhost:5432/volar?schema=public"

# Clerk (autenticación de usuarios y staff)
# Obtené las claves en el dashboard de Clerk → API Keys.
# No commitear valores reales; copiar este archivo a .env y completar allí.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# URL pública de la aplicación. Se usa, por ejemplo, para armar los enlaces de
# contingencia que se envían por email.
APP_URL=http://localhost:3000

# Configuración SMTP para el envío de emails (US-25)
# No commitear valores reales; copiar este archivo a .env y completar allí.
# Para pruebas se recomienda usar una cuenta sandbox (p. ej. Mailtrap) o un
# proveedor con "app password" (Gmail/Outlook) en lugar de la contraseña real.
#
# Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=tu_cuenta@gmail.com
#   SMTP_PASSWORD=tu_app_password
#
# Outlook / Microsoft 365:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=tu_cuenta@example.com
#   SMTP_PASSWORD=tu_app_password
#
# Mailtrap (sandbox):
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=587 o 2525
#   SMTP_SECURE=false
#   SMTP_USER=<usuario>
#   SMTP_PASSWORD=<password>
#
# TLS/SSL:
#   - Puerto 465 + SMTP_SECURE=true  -> TLS implícito.
#   - Puerto 587 + SMTP_SECURE=false -> STARTTLS.
# Para verificar la conexión: pnpm exec tsx scripts/test-smtp.ts
# Para despachar las notificaciones de contingencia pendientes: pnpm mail:send
# (sin SMTP configurado cada fila queda PENDING y se puede reintentar luego)
SMTP_HOST=""
SMTP_PORT=""
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""
